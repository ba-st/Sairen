Class {
	#name : 'SairenIcons',
	#superclass : 'Object',
	#classInstVars : [
		'icons'
	],
	#category : 'Sairen-UI',
	#package : 'Sairen-UI'
}

{ #category : 'initialization' }
SairenIcons class >> icons [

    ^ icons ifNil: [ icons := Dictionary new ]
]

{ #category : 'initialization' }
SairenIcons class >> resetIcons [
    <script>
    ^ icons := nil
]

{ #category : 'initialization' }
SairenIcons class >> sairenIcon [

	<script: 'self sairenIcon inspect'>
	
	^ self icons at: #sairenIcon ifAbsentPut: [
			  ( Form fromBinaryStream: self sairenIconBase64 base64Decoded asByteArray readStream )
				  scaledToSize: 20 @ 20
		  ]
]

{ #category : 'initialization' }
SairenIcons class >> sairenIconBase64 [

	^ ''
]

"
Icons for the Sairen web example.
"
Class {
	#name : 'SairenExampleFileMetadataLibrary',
	#superclass : 'WADeploymentAwareFileMetadataLibrary',
	#category : 'Sairen-Examples-Libraries',
	#package : 'Sairen-Examples',
	#tag : 'Libraries'
}

{ #category : 'Accessing' }
SairenExampleFileMetadataLibrary class >> forDeployment [

	^ self default
]

{ #category : 'Accessing' }
SairenExampleFileMetadataLibrary class >> forDevelopment [

	^ self default
]

{ #category : 'testing' }
SairenExampleFileMetadataLibrary class >> isForDeployment [

	^true
]

{ #category : 'testing' }
SairenExampleFileMetadataLibrary class >> isForDevelopment [

	^true
]

{ #category : 'Accessing' }
SairenExampleFileMetadataLibrary class >> libraryName [

	^ 'sairen-apps'
]

{ #category : 'Accessing' }
SairenExampleFileMetadataLibrary class >> version [

	^ '1.0.0'
]

{ #category : 'private' }
SairenExampleFileMetadataLibrary >> csssairenCss [

	^ WAFileLibraryResource
		  filepath: 'css/sairen.css'
		  mimeType: WAMimeType textCss
		  cacheDuration: self class defaultCacheDuration
		  contents: self csssairenCssContent
]

{ #category : 'private' }
SairenExampleFileMetadataLibrary >> csssairenCssContent [

	^ String streamContents: [ :stream |
			  SairenExampleCascadingStyleSheetBuilder new build printOn: stream ]
]

{ #category : 'private' }
SairenExampleFileMetadataLibrary >> faviconIco [

	^ WAFileLibraryResource
		  filepath: 'favicon.ico'
		  mimeType: ( WAMimeType main: 'image' sub: 'x-icon' )
		  cacheDuration: self class defaultCacheDuration
		  contents: ( GRDelayedSend receiver: self selector: #faviconIcoContent )
]


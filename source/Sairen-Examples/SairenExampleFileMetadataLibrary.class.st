{ #category : 'private' }
SairenExampleFileMetadataLibrary >> jssairenJs [

	^ WAFileLibraryResource
		  filepath: 'js/sairen.js'
		  mimeType: WAMimeType applicationJavascript
		  cacheDuration: self class defaultCacheDuration
		  contents: ( GRDelayedSend receiver: self selector: #jssairenJsContent )
